<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutSubjectNavItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_8"
    app:cardCornerRadius="@dimen/card_corner_radius_12"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: Background Color and Title -->
        <RelativeLayout
            android:id="@+id/titleLo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin_16"
            android:background="@drawable/drawable_background_biology"
            android:visibility="gone">

            <TextView
                android:id="@+id/subjectTitleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Biology"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_20"
                android:textStyle="bold"
                android:layout_centerVertical="true"/>

            <ImageView
                android:id="@+id/navArrowLo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_navigate_next"
                app:tint="@color/white"
                android:visibility="gone"/>
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/contentLo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_16">

            <!-- Package Info -->
            <TextView
                android:id="@+id/tvPackageType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/package_info"
                android:textColor="@color/primary_text_color"
                android:textSize="@dimen/text_size_14"
                android:textStyle="bold" />

            <!-- Status Info -->
            <TextView
                android:id="@+id/tvSubjectStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/status_info"
                android:textColor="@color/color_green"
                android:textSize="@dimen/text_size_14"
                android:textStyle="bold" />

            <!-- Expiry Info -->
            <TextView
                android:id="@+id/expiresInTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/expires_in"
                android:textColor="@color/color_red"
                android:textSize="@dimen/text_size_14"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"
            android:layout_marginHorizontal="@dimen/margin_16"/>

        <!-- Action Buttons Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:padding="@dimen/margin_8">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvPaper1"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/paper_1"
                android:textSize="12sp"
                app:strokeColor="@color/color_primary"
                android:textColor="@color/color_primary"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvPaper2"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/paper_2"
                android:textSize="12sp"
                app:strokeColor="@color/color_primary"
                android:textColor="@color/color_primary"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvDictionary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/dictionary"
                android:textSize="12sp"
                app:strokeColor="@color/color_primary"
                android:textColor="@color/color_primary"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvSyllabus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/notes"
                android:textSize="12sp"
                app:strokeColor="@color/color_primary"
                android:textColor="@color/color_primary"
                app:cornerRadius="8dp" />

        </GridLayout>

        <!-- Main Action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubscribe"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginHorizontal="@dimen/margin_16"
            android:layout_marginBottom="@dimen/margin_16"
            android:text="@string/subscribe"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/btn_subscribe_text"
            app:backgroundTint="@color/btn_subscribe_background"
            app:cornerRadius="12dp"
            app:elevation="4dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
